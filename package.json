{
  "name": "kalp",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "change": "changeset",
    "change:solo": "rm -rf .changeset/*.md && changeset",
    "change:status": "changeset status",
    "version-packages": "changeset version",
    "version:snapshot": "changeset version --snapshot",
    "release": "turbo build && changeset publish",
    "dev-release": "node scripts/dev-release.mjs",
    "sync-versions": "node scripts/sync-versions.mjs",
    "clean-changelogs": "node scripts/clean-changelogs.mjs",
    "check-boundaries": "bash scripts/check-boundaries.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
