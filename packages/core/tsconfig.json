{
  "extends": "../typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
