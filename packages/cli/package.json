{
  "name": "@kalphq/cli",
  "version": "0.2.0",
  "description": "Zero-config CLI for deploying Kalp agents",
  "type": "module",
  "license": "MIT",
  "author": "Kalp HQ",
  "bin": {
    "kalp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && pnpm run build:studio && pnpm run build:copy-template",
    "build:studio": "pnpm --filter=@kalphq/studio build",
    "build:copy-template": "node scripts/copy-studio-assets.mjs",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "vitest"
  },
  "dependencies": {
    "@antfu/ni": "24.4.0",
    "@clack/prompts": "0.9.1",
    "@kalphq/cloudflare": "workspace:*",
    "@kalphq/compiler": "workspace:*",
    "@kalphq/project": "workspace:*",
    "@kalphq/sdk": "workspace:*",
    "chokidar": "^4.0.3",
    "citty": "0.1.6",
    "esbuild": "0.25.0",
    "execa": "^9.6.1",
    "hono": "^4.12.18",
    "jiti": "^2.6.1",
    "jose": "^5.10.0",
    "json-schema-to-typescript": "^15.0.4",
    "json-stable-stringify": "1.3.0",
    "miniflare": "4.20260507.1",
    "open": "^11.0.0",
    "picocolors": "1.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/json-stable-stringify": "1.2.0",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^1.6.1",
    "tsup": "^8.3.5",
    "typescript": "^5.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "1.6.1"
  }
}
